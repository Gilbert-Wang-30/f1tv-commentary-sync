# fone's settings for docker-compose.yml. Copy this file to .env (gitignored) in the same folder
# and fill it in: docker compose reads it from there. Only FONE_RECORDINGS is required; a line
# left commented out keeps the default shown. Regexes go in single quotes.

# ---- the server ---------------------------------------------------------------------------

# Where the recordings are: the folder every recorder writes under, a folder per streamer in
# it. The server reads all of it (read-only) and writes only into fone-import/ (backfill's
# replays); fone's own recorders write into fone/. Create both first, fone/ owned by
# FONE_UID:FONE_GID (below), the user fone-streamlink writes as (on a share: its mount's uid/gid):
#   mkdir -p /srv/recordings/fone /srv/recordings/fone-import
#   sudo chown 1000:1000 /srv/recordings/fone
FONE_RECORDINGS=/srv/recordings

# The server image: the release, or a build of your own (`docker compose build fone`).
#FONE_IMAGE=ghcr.io/gilbert-wang-30/fone:1.0.1
#FONE_PORT=8788
# The address the server's port (and fone-ext's) is published on. Unset: every interface, IPv4
# and IPv6, for the browsers elsewhere on your LAN. The server has no login: on a VPS, or any
# host the internet reaches, never leave it unset. Give it a private address instead: the host's
# Tailscale or WireGuard address (`tailscale ip -4`), or 127.0.0.1 and an SSH tunnel from each
# browser's machine (ssh -N -L 8788:127.0.0.1:8788 <host>, then http://localhost:8788 in fone's
# settings). A firewall on the host doesn't cover it: Docker's published ports bypass ufw's
# rules. A VPN's address must exist when Docker starts, or the containers on it fail to start
# after a reboot (Docker doesn't retry them): set the sysctl net.ipv4.ip_nonlocal_bind=1, or
# start Docker after the VPN (`sudo systemctl edit docker`: [Unit] After=tailscaled.service and
# Wants=tailscaled.service, or wg-quick@wg0.service for WireGuard). 127.0.0.1 is always there.
#FONE_BIND=127.0.0.1
# A cap on the server's CPUs, e.g. 2 on a host that also runs the recorders (0: none).
#FONE_CPUS=0

# ---- your streamer ------------------------------------------------------------------------

# Bilibili rooms, room=channel, comma-separated: the room is the number in its
# live.bilibili.com/<room> address, the channel the name fone shows. This one setting gives
# fone-recorder its rooms (on its first start), the live-status log and backfill of missed
# streams, the 弹幕, and in the extension: live straight from the room, the ↗ Live page and the
# streamer's Bilibili replays for sessions you have no recording of. A room number alone is a
# channel of that name. Empty: none of that (a streamer on another site needs none of it), and
# fone-recorder (the recorder profile) doesn't start: it would have nothing to record.
FONE_ROOMS=
#FONE_ROOMS=12345678=MyStreamer

# A recorder folder shown under another channel name: folder=channel, comma-separated.
# fone-recorder's folders are its room numbers, which FONE_ROOMS names already; a 录播姬 of
# your own may name them after the account (e.g. AccountName=MyStreamer).
FONE_CHANNEL_ALIASES=

# The time zone of the times in the recordings' file names. fone's recorders below write them
# in it; 录播姬's own default template writes Beijing time (Asia/Shanghai). A recorder of your
# own must use the same, or its recordings land hours off (the server log warns).
FONE_FILENAME_TZ=Asia/Shanghai

# Seconds your streamer typically lags the race: where a video nothing is known about starts.
#FONE_DEFAULT_DELAY=40

# Sponsor clips to mute: the reference clips the image carries are one streamer's (胡闹P房's),
# matched on that channel only. FONE_ADS_REFS: a set of your own instead, a folder the server
# sees with its refs.npz (README → Configure your streamer), matched on every channel.
# FONE_ADS_CHANNELS: the channels to match either on, comma-separated, or * for all.
#FONE_ADS_REFS=/data/ads
#FONE_ADS_CHANNELS=

# Days the server keeps a session's timing (the stats): OpenF1's rebuilds are deleted after
# this and rebuilt when asked for (a minute or so, ~100 MB down for a race); what it captured
# live is kept while F1's archive refuses (since 2026-10-18), as the only copy.
#FONE_TIMING_KEEP_DAYS=30

# Optional services, all on: =0 switches one off.
#FONE_TIMING=0
#FONE_SCREENCLOCK=0
#FONE_VIDEO=0
#FONE_BACKFILL=0
#FONE_DANMAKU=0
#FONE_VODCLOCK=0
#FONE_ADS=0

# ---- recording ----------------------------------------------------------------------------

# Optional services `docker compose up -d` starts too, comma-separated:
#   recorder    fone-recorder (录播姬, FONE_ROOMS's rooms), its title gate and the janitor
#   streamlink  fone-streamlink, streamers on other sites (FONE_STREAMS), and the janitor
#   ext-update  fone-ext, the self-hosted extension update channel (README → Advanced)
#COMPOSE_PROFILES=recorder

# The uid:gid the recorders write as: the owner of <FONE_RECORDINGS>/fone.
#FONE_UID=1000
#FONE_GID=1000

# fone-recorder-gate keeps fone-recorder to F1 by the stream's title (Python regexes,
# case-insensitive). GATE_RECORD: titles to record (empty: F1/F2/F3, Formula, Grand Prix, GP,
# FP1-3, Qualifying, Sprint, Race and the Chinese session names; a value replaces those, so a
# streamer's tag goes in with the words, as below); GATE_SKIP: titles never to
# record. GATE_ACTION: log (the default: it only says what it would stop) or stop (stops a
# recording whose title doesn't match and deletes the seconds-long stub that leaves; restarts it
# if the title turns F1). Watch its log (docker logs fone-recorder-gate) before choosing stop.
# The server's backfill fills by itself only a live with a title these keep (a game stream the
# gate stopped isn't missing), unless FONE_BACKFILL_RECORD / FONE_BACKFILL_SKIP say otherwise
# (FONE_BACKFILL_RECORD=. fills every live; left empty, they're the gate's again).
#GATE_RECORD='【MyStreamer】|F1|Formula|大奖赛'
#GATE_SKIP=
#GATE_ACTION=stop
#FONE_BACKFILL_RECORD=
#FONE_BACKFILL_SKIP=

# fone-streamlink: channel=URL, separated by spaces; streamlink's stream names, the first one
# there wins; and a title to wait for before recording (grep -E, case-insensitive; empty: any).
#FONE_STREAMS=mystreamer=https://www.twitch.tv/mystreamer
#FONE_STREAMS_QUALITY=audio_only,360p,480p,worst
#FONE_STREAMS_RECORD='F1|Formula|Grand Prix'

# fone-janitor: days recordings and imports are kept after they end.
#FONE_KEEP_DAYS=21

# fone-ext (ext-update): the folder tools/publish_ext.sh fills (FONE_EXT_DIST in tools/publish.env).
#FONE_EXT_DIST=/srv/fone-dist
