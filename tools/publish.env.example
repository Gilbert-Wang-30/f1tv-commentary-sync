# Local settings for tools/publish_ext.sh: copy to tools/publish.env (gitignored) and fill in
# your own. The same variables set in the environment win over this file.

# The published build's default fone servers, comma-separated, tried in order (the first that
# answers wins). publish_ext.sh writes them into the extension's local.js; anyone can still
# change them in fone's settings. Put the address that works away from home first (the
# server's Tailscale name, <machine>.<tailnet>.ts.net, or just the machine's name), the LAN
# address second.
FONE_SERVERS=http://my-server:8788,http://192.168.1.20:8788

# Where Chrome loads the extension unpacked: a folder every machine at home can reach, such
# as a network share.
FONE_EXT_DEST=/mnt/share/apps/fone-extension

# What the fone-ext update server serves (docker-compose.yml mounts it at /srv: the same folder
# goes in .env as FONE_EXT_DIST, with ext-update in COMPOSE_PROFILES).
FONE_EXT_DIST=/mnt/share/apps/fone-dist

# The update server as a Mac reaches it (install-mac.sh and fone-sync.sh download from here).
FONE_DIST_URL=http://my-server:8789
